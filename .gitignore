# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/
next-env.d.ts

# Production
/build

# Environment — NEVER commit real keys.
# `.env*` with an explicit exception, rather than a list of the ones we happened
# to think of: the previous list covered .env, .env*.local and .env.production
# but not .env.development, .env.staging or .env.test — and Next loads the first
# and third of those by convention (finding R3-L2).
.env*
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

